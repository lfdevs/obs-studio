Subject: [PATCH 05/10] Fix spelling mistakes

---
 deps/w32-pthreads/pthread_attr_getstackaddr.c               | 2 +-
 plugins/linux-alsa/alsa-input.c                             | 2 +-
 plugins/obs-outputs/librtmp/rtmp.h                          | 2 +-
 plugins/obs-websocket/src/forms/ConnectInfo.cpp             | 2 +-
 plugins/obs-websocket/src/forms/SettingsDialog.cpp          | 6 +++---
 .../obs-websocket/src/websocketserver/WebSocketServer.cpp   | 6 +++---
 6 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/deps/w32-pthreads/pthread_attr_getstackaddr.c b/deps/w32-pthreads/pthread_attr_getstackaddr.c
index 15a3f00..80052a1 100644
--- a/deps/w32-pthreads/pthread_attr_getstackaddr.c
+++ b/deps/w32-pthreads/pthread_attr_getstackaddr.c
@@ -72,7 +72,7 @@ pthread_attr_getstackaddr (const pthread_attr_t * attr, void **stackaddr)
       *                      address..
       *
       * RESULTS
-      *              0               successfully retreived stack address,
+      *              0               successfully retrieved stack address,
       *              EINVAL          'attr' is invalid
       *              ENOSYS          function not supported
       *
diff --git a/plugins/linux-alsa/alsa-input.c b/plugins/linux-alsa/alsa-input.c
index cb6d79d..c07c290 100644
--- a/plugins/linux-alsa/alsa-input.c
+++ b/plugins/linux-alsa/alsa-input.c
@@ -451,7 +451,7 @@ bool _alsa_configure(struct alsa_data *data)
 	}
 #undef FORMAT_SIZE
 	if (!format_found) {
-		blog(LOG_ERROR, "device doesnt support any OBS formats");
+		blog(LOG_ERROR, "device doesn't support any OBS formats");
 		return false;
 	}
 	snd_pcm_hw_params_set_format(data->handle, hwparams, data->format);
diff --git a/plugins/obs-outputs/librtmp/rtmp.h b/plugins/obs-outputs/librtmp/rtmp.h
index c1b8d90..439d28e 100644
--- a/plugins/obs-outputs/librtmp/rtmp.h
+++ b/plugins/obs-outputs/librtmp/rtmp.h
@@ -36,7 +36,7 @@
 
 #ifdef _WIN32
 #ifdef _MSC_VER
-#pragma warning(disable:4996) //depricated warnings
+#pragma warning(disable:4996) //deprecated warnings
 #pragma warning(disable:4244) //64bit defensive mechanism, fixed the ones that mattered
 #endif
 #include <winsock2.h>
diff --git a/plugins/obs-websocket/src/forms/ConnectInfo.cpp b/plugins/obs-websocket/src/forms/ConnectInfo.cpp
index 06507a6..5e6add9 100644
--- a/plugins/obs-websocket/src/forms/ConnectInfo.cpp
+++ b/plugins/obs-websocket/src/forms/ConnectInfo.cpp
@@ -51,7 +51,7 @@ void ConnectInfo::RefreshData()
 {
 	auto conf = GetConfig();
 	if (!conf) {
-		blog(LOG_ERROR, "[ConnectInfo::showEvent] Unable to retreive config!");
+		blog(LOG_ERROR, "[ConnectInfo::showEvent] Unable to retrieve config!");
 		return;
 	}
 
