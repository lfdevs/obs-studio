diff --git a/shared/media-playback/media-playback/vaapi-device.h b/shared/media-playback/media-playback/vaapi-device.h
new file mode 100644
index 0000000..9b972d5
--- /dev/null
+++ b/shared/media-playback/media-playback/vaapi-device.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+
+#include <stdlib.h>
+#include <string.h>
+
+/* Share the device selection between media sources and VA-API encoders. */
+static inline const char *mp_get_vaapi_device(void)
+{
+	const char *device = getenv("OBS_VAAPI_DEVICE");
+	if (device && *device)
+		return device;
+
+	const char *bridge = getenv("TERMUX_VA_BRIDGE");
+	const char *backend = getenv("TERMUX_VA_GPU_BACKEND");
+	if (bridge && (strcmp(bridge, "1") == 0 || strcmp(bridge, "true") == 0 || strcmp(bridge, "on") == 0) &&
+	    backend && strcmp(backend, "kgsl") == 0)
+		return "/dev/kgsl-3d0";
+
+	return NULL;
+}
